	)
	(text "Decoupling: one 100 nF ceramic at each chip's VCC pin (chip named below);\n22 uF bulk on +3.3V near the Pico's 3V3 pin. Rev 1 runs from the Pico's USB:\nkeep the external 3V3 load under ~300 mA. VSYS is left free for a rev-2 power input."
		(exclude_from_sim no)
		(at 20.32 219.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1a5bacff-70a3-4efd-bde5-b2e9db99ee31")
	)
